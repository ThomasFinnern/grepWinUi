<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GrepWinUi.Core\GrepWinUi.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.1.0</Version>
    <ApplicationIcon>Resources\grepWinUi.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Standard data files (one per stored class), read when no user file exists -->
  <ItemGroup>
    <None Update="Defaults\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>